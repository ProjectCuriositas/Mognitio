    "pipeline_source": "namespace Mgnc\\Pipeline;\nuse Std\\Binary\\{Bytes};\nuse Std\\Io\\{writeStderr,IoError};\nuse Mgnc\\Data\\{Diagnostic,Token,Paged,number};\nuse Mgnc\\Syntax\\{Program};\nuse Mgnc\\Checked\\{CheckedProgram};\nuse Mgnc\\IR\\{ModuleIR};\nuse Mgnc\\Machine\\{Code,Record};\nuse Mgnc\\Frontend\\{scan};\nuse Mgnc\\Module\\{parse};\nuse Mgnc\\Check\\{check};\nuse Mgnc\\Lower\\{lower};\nuse Mgnc\\Verify\\{verify};\nuse Mgnc\\Native\\{generate};\nuse Mgnc\\Encode\\{encode};\nlet scanned:Function(String):Result<Paged<Token>,Diagnostic>=function(source:String):Result<Paged<Token>,Diagnostic>{\n let tokens:Paged<Token>=try scan(source);discard writeStderr(\"scan \"+number(tokens->count)+\"\\n\");Result<Paged<Token>,Diagnostic>::Ok(tokens)\n};\nlet parsed:Function(Paged<Token>):Result<Program,Diagnostic>=function(tokens:Paged<Token>):Result<Program,Diagnostic>{\n let syntax:Program=try parse(tokens);discard writeStderr(\"parse \"+number(syntax->nodes->count)+\"\\n\");Result<Program,Diagnostic>::Ok(syntax)\n};\nlet checked:Function(Program):Result<CheckedProgram,Diagnostic>=function(syntax:Program):Result<CheckedProgram,Diagnostic>{\n let value:CheckedProgram=try check(syntax);discard writeStderr(\"check\\n\");Result<CheckedProgram,Diagnostic>::Ok(value)\n};\nlet checkedIR:Function(String):Result<ModuleIR,Diagnostic>=function(source:String):Result<ModuleIR,Diagnostic>{\n let value:ModuleIR=try lower(try checked(try parsed(try scanned(source))));\n discard writeStderr(\"lower\\n\");Result<ModuleIR,Diagnostic>::Ok(value)\n};\nlet verifiedIR:Function(String):Result<ModuleIR,Diagnostic>=function(source:String):Result<ModuleIR,Diagnostic>{\n let module:ModuleIR=try checkedIR(source);try verify(module);discard writeStderr(\"verify\\n\");Result<ModuleIR,Diagnostic>::Ok(module)\n};\nlet machineCode:Function(String):Result<Code,Diagnostic>=function(source:String):Result<Code,Diagnostic>{\n let code:Code=try generate(try verifiedIR(source));\n var labelCount:Int=0;\n loop over(code->records->pages->append(code->records->tail) as page:List<Record>){\n  loop over(page as record:Record){branch when{record->kind==1=>{labelCount=labelCount+1;},else=>unit};};\n };\n discard writeStderr(\"generate \"+number(code->records->count)+\" \"+number(labelCount)+\" \"+number(code->nextLabel)+\"\\n\");Result<Code,Diagnostic>::Ok(code)\n};\npublic let compile:Function(String):Result<Bytes,Diagnostic>=function(source:String):Result<Bytes,Diagnostic>{\n let bytes:Bytes=try encode(try machineCode(source));discard writeStderr(\"encode\\n\");Result<Bytes,Diagnostic>::Ok(bytes)\n};\n",
