(defun directory-scan-mutation ()
  (when (option :directory-scan-mutation)
    (scoped-forms :scan-mutation
      (append '((:test) (:jz :done) (:load-frame :rsi -208))
        (ecase (option :directory-scan-mutation)
          (:count '((:imm-rax 65537))) (:header '((:imm-rax 19)))
          (:reclen '((:imm-rdx 0) (:store-byte :rsi 16 :rdx) (:store-byte :rsi 17 :rdx)))
          (:alignment '((:imm-rdx 25) (:store-byte :rsi 16 :rdx)))
          (:end '((:imm-rdx 255) (:store-byte :rsi 16 :rdx) (:store-byte :rsi 17 :rdx)))
          (:empty '((:imm-rdx 0) (:store-byte :rsi 19 :rdx)))
          (:slash '((:imm-rdx 47) (:store-byte :rsi 19 :rdx)))
          (:utf8 '((:imm-rdx 255) (:store-byte :rsi 19 :rdx)))
          (:dtype '((:imm-rdx 8) (:store-byte :rsi 18 :rdx)))
          (:nul (append '((:imm-rdx 120)) (loop for i from 19 below 24 collect (list :store-byte :rsi i :rdx)))))
        '((:label :done))))))

(defun directory-scan-records ()
  (let ((bytes (option :directory-scan-records)))
    (when bytes
      (unless (and (typep bytes '(vector (unsigned-byte 8))) (<= (length bytes) 65536))
        (internal-error "Invalid private directory record fixture"))
      (scoped-forms :scan-records
        (append '((:load-frame :rax -712) (:test) (:jnz :end) (:imm-rax 1) (:store-frame -712 :rax)
                  (:load-frame :rsi -208))
          (loop for byte across bytes for i from 0 append `((:imm-rdx ,byte) (:store-byte :rsi ,i :rdx)))
          `((:imm-rax ,(length bytes)) (:jmp :done) (:label :end) (:imm-rax 0) (:label :done)))))))

