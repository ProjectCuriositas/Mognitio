         (entry-fields (mognitio.semantic:type-info-fields (mognitio.semantic:context-type context entry-type)))
         (kind-type (cdr (second entry-fields))))
    (append
      '((:load-frame :rax -288) (:store-out 0 :rax) (:load-frame :rax -352) (:store-out 8 :rax)
        (:load-frame :rax -144) (:store-out 16 :rax) (:call (:runtime :directory.sort)))
      `((:lea-object ,(static-name :list list-type)) (:store-frame -56 :rax)
        (:label :materialize) (:load-frame :rax -576) (:load-frame :rcx -144) (:cmp) (:jae :materialized)
        (:imm-rcx 40) (:mul) (:load-frame :rdx -288) (:add-reg :rdx :rax) (:store-frame -592 :rdx)
        (:load-frame :rax -584) (:test) (:jz :unique) (:store-out 0 :rax) (:store-out 8 :rdx)
        (:load-frame :rax -352) (:store-out 16 :rax) (:call (:runtime :directory.name-compare))
        (:test) (:jz :skip-duplicate) (:label :unique)
        (:load-frame :rdx -592) (:load-word :rax :rdx 0) (:store-frame -120 :rax)
        (:load-word :rax :rdx 8) (:store-frame -128 :rax) (:load-word :rax :rdx 16) (:store-frame -136 :rax)
        (:load-word :rax :rdx 24) (:store-frame -608 :rax))
      (directory-name-forms -32)
      (loop for kind below 4 append
        (let ((label (intern (format nil "ENTRY-KIND-~D" kind) :keyword)))
          (append `((:load-frame :rax -608) (:cmp-imm :rax ,kind) (:jnz ,label))
            (allocate-object label (list :descriptor (second kind-type) kind) 2 0 kind)
            '((:store-frame -40 :rdx) (:jmp :entry-value)) `((:label ,label)))))
      '((:jmp :internal) (:label :entry-value))
      (allocate-object :entry (list :descriptor (second entry-type) 0) 1 2)
      '((:load-frame :rax -32) (:store-word :rdx 32 :rax) (:load-frame :rax -40) (:store-word :rdx 40 :rax)
        (:store-frame -48 :rdx) (:load-frame :rax -56) (:load-word :rax :rax 32))
      `((:imm-rcx ,(option :directory-length-limit 9223372036854775807)) (:cmp) (:jae :list-length-overflow))
