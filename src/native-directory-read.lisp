(defun directory-name-forms (slot)
  (append
    `((:load-frame :rax -128) (:store-out 0 :rax) (:load-frame :rax -136) (:store-out 8 :rax)
      (:call (:runtime :allocate)) (:store-frame ,slot :rax) (:lea-base :rdi :rax 32)
      (:load-frame :rsi -352) (:load-frame :rax -120) (:add-reg :rsi :rax) (:load-frame :rcx -128))
    (copy-forms (intern (format nil "MATERIALIZE-NAME-~D" (- slot)) :keyword))))

(defun directory-materialize-forms (list-type context)
