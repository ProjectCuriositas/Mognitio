public let byte:Function(Int,Span):Result<Bits<8>,Diagnostic>=function(value:Int,span:Span):Result<Bits<8>,Diagnostic>{
 branch on value->convertTo<Int<8,Unsigned>>(){
  Result<Int<8,Unsigned>,IntegerConversionError>::Ok(fixed:Int<8,Unsigned>)=>Result<Bits<8>,Diagnostic>::Ok(fixed->toBits()),
  Result<Int<8,Unsigned>,IntegerConversionError>::Err(error:IntegerConversionError)=>Result<Bits<8>,Diagnostic>::Err(problem("internal",span,"opcode byte out of range")),
 }
};
public let appendField:Function(List<Bits<8>>,Bytes,Span):Result<List<Bits<8>>,Diagnostic>=
function(initial:List<Bits<8>>,field:Bytes,span:Span):Result<List<Bits<8>>,Diagnostic>{
 var result:List<Bits<8>>=initial;var index:Int=0;
 loop while(index<field->length()){
  let value:Bits<8>=branch on field->at(index){
   Result<Bits<8>,IndexError>::Ok(octet:Bits<8>)=>octet,
   Result<Bits<8>,IndexError>::Err(error:IndexError)=>{return Result<List<Bits<8>>,Diagnostic>::Err(problem("internal",span,"encoded field bounds"));},
  };
  result=result->append(value);index=index+1;
 };
 Result<List<Bits<8>>,Diagnostic>::Ok(result)
};
