public let u32:Function(Int,Span):Result<Bytes,Diagnostic>=function(value:Int,span:Span):Result<Bytes,Diagnostic>{
 let fixed:Int<32,Unsigned>=branch on value->convertTo<Int<32,Unsigned>>(){
  Result<Int<32,Unsigned>,IntegerConversionError>::Ok(converted:Int<32,Unsigned>)=>converted,
