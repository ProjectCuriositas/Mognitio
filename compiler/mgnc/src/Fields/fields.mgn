namespace Mgnc\Fields;
use Std\Numeric\{Bits,Signed,Unsigned,IntegerConversionError};
use Std\Binary\{Bytes,ByteOrder,BitWidthError};
use Mgnc\Data\{Diagnostic,problem,Span};
public let i32:Function(Int,Span):Result<Bytes,Diagnostic>=function(value:Int,span:Span):Result<Bytes,Diagnostic>{
 let fixed:Int<32,Signed>=branch on value->convertTo<Int<32,Signed>>(){
  Result<Int<32,Signed>,IntegerConversionError>::Ok(converted:Int<32,Signed>)=>converted,
  Result<Int<32,Signed>,IntegerConversionError>::Err(error:IntegerConversionError)=>{return Result<Bytes,Diagnostic>::Err(problem("internal",span,"encoding field out of range"));},
 };
 branch on fixed->toBits()->toBytes(ByteOrder::LittleEndian){
  Result<Bytes,BitWidthError>::Ok(bytes:Bytes)=>Result<Bytes,Diagnostic>::Ok(bytes),
  Result<Bytes,BitWidthError>::Err(error:BitWidthError)=>Result<Bytes,Diagnostic>::Err(problem("internal",span,"invalid encoding field width")),
 }
};
public let i64:Function(Int,Span):Result<Bytes,Diagnostic>=function(value:Int,span:Span):Result<Bytes,Diagnostic>{
 let fixed:Int<64,Signed>=branch on value->convertTo<Int<64,Signed>>(){
