namespace Mgnc;
use Std\Io\{writeStderr, IoError};
// Until the pipeline is connected, never report compilation success.
let main: Function(List<String>): Int = function(args: List<String>): Int {
    branch on writeStderr("mgnc: internal: compiler pipeline is not connected\n") {
        Result<Unit, IoError>::Ok(value: Unit) => 3,
        Result<Unit, IoError>::Err(error: IoError) => 2,
    }
};
