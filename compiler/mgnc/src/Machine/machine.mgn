namespace Mgnc\Machine;
use Mgnc\Data\{Paged,push};
public type Record=product{kind:Int;bytes:List<Int>;value:Int;target:Int;};
public type Code=product{records:Paged<Record>;nextLabel:Int;pending:List<Int>;};
public type Label=product{id:Int;offset:Int;};
public type Layout=product{entry:Int;epilogue:Int;blocks:Int;frame:Int;};
public let raw:Function(Code,List<Int>):Code=function(code:Code,bytes:List<Int>):Code{
 var pending:List<Int>=code->pending;
 branch when{pending->length()==0=>{pending=bytes;},else=>{
  loop over(bytes as byte:Int){pending=pending->append(byte);};
 }};
 Code{records:code->records,nextLabel:code->nextLabel,pending:pending}
};
public let flush:Function(Code):Code=function(code:Code):Code{
 branch when{code->pending->length()==0=>code,else=>
  Code{records:push<Record>(code->records,Record{kind:0,bytes:code->pending,value:0,target:0}),
       nextLabel:code->nextLabel,pending:List<Int>[]}}
};
public let label:Function(Code,Int):Code=function(initial:Code,id:Int):Code{
 let code:Code=flush(initial);
 Code{records:push<Record>(code->records,Record{kind:1,bytes:List<Int>[],value:0,target:id}),
      nextLabel:code->nextLabel,pending:List<Int>[]}
};
public let field:Function(Code,Int,Int):Code=function(code:Code,kind:Int,value:Int):Code{
 Code{records:push<Record>(code->records,Record{kind:kind,bytes:code->pending,value:value,target:0}),
      nextLabel:code->nextLabel,pending:List<Int>[]}
};
public let reference:Function(Code,Int,Int):Code=function(code:Code,kind:Int,target:Int):Code{
 Code{records:push<Record>(code->records,Record{kind:kind,bytes:code->pending,value:0,target:target}),
      nextLabel:code->nextLabel,pending:List<Int>[]}
};
public let jump:Function(Code,List<Int>,Int):Code=function(code:Code,opcode:List<Int>,target:Int):Code{
 reference(raw(code,opcode),2,target)
};
public let fresh:Function(Code,Int):Code=function(code:Code,count:Int):Code{
 Code{records:code->records,nextLabel:code->nextLabel+count,pending:code->pending}
};
