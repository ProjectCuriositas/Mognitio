namespace Mgnc\Pipeline;
use Std\Binary\{Bytes};
use Mgnc\Data\{Diagnostic};
use Mgnc\Checked\{CheckedProgram};
use Mgnc\IR\{ModuleIR};
use Mgnc\Machine\{Code};
use Mgnc\Frontend\{scan};
use Mgnc\Module\{parse};
use Mgnc\Check\{check};
use Mgnc\Lower\{lower};
use Mgnc\Verify\{verify};
use Mgnc\Native\{generate};
use Mgnc\Encode\{encode};
let checkedIR:Function(String):Result<ModuleIR,Diagnostic>=function(source:String):Result<ModuleIR,Diagnostic>{
 lower(try check(try parse(try scan(source))))
};
let verifiedIR:Function(String):Result<ModuleIR,Diagnostic>=function(source:String):Result<ModuleIR,Diagnostic>{
 let module:ModuleIR=try checkedIR(source);try verify(module);
 Result<ModuleIR,Diagnostic>::Ok(module)
};
let machineCode:Function(String):Result<Code,Diagnostic>=function(source:String):Result<Code,Diagnostic>{
 generate(try verifiedIR(source))
};
public let compile:Function(String):Result<Bytes,Diagnostic>=function(source:String):Result<Bytes,Diagnostic>{
 encode(try machineCode(source))
};
