namespace App;
let main: Function(List<String>): Int = function(args: List<String>): Int {
let add :Function(Int,Int):Int= function(a: Int, b: Int): Int { a + b };
let subtract :Function(Int,Int):Int= function(a: Int, b: Int): Int { a - b };
var count: Int = 0;
var total: Int = 0;
loop while (count < 4) {
    total = total + (branch when{(count < 2)=>{ add },else=>{ subtract }})(10, count);
    count = count + 1;
};
branch when { (total == 36) == true => 0, else => panic {"fixture mismatch"} } };
