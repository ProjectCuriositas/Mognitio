type Item = product { text: String; };
type State = sum { Empty; Ready(Item); };
contract Named { name(self: Self): String; }
implement Item against Named {
    name(item: Self): String { item.text }
}
let render: Function(Named): String = function(value: Named): String {
    value->name()
};
branch on State::Ready(Item { text: "example" }) {
    State::Empty => false,
    State::Ready(item: Item) => render(Named(item)) == "example",
}
