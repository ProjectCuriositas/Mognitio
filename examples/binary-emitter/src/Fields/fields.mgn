namespace Emitter\Fields;
use Std\Numeric\{Bits,Signed,Unsigned,IntegerConversionError};
use Std\Binary\{Bytes,bytesFromBits,ByteOrder,BitWidthError};
public let u16:Function(Int):Result<Bytes,String>=function(value:Int):Result<Bytes,String>{
 let fixed:Int<16,Unsigned>=try branch on value->convertTo<Int<16,Unsigned>>(){
 Result<Int<16,Unsigned>,IntegerConversionError>::Ok(x:Int<16,Unsigned>)=>Result<Int<16,Unsigned>,String>::Ok(x),
 Result<Int<16,Unsigned>,IntegerConversionError>::Err(e:IntegerConversionError)=>Result<Int<16,Unsigned>,String>::Err("field range")};
 branch on fixed->toBits()->toBytes(ByteOrder::LittleEndian){
 Result<Bytes,BitWidthError>::Ok(x:Bytes)=>Result<Bytes,String>::Ok(x),
 Result<Bytes,BitWidthError>::Err(e:BitWidthError)=>Result<Bytes,String>::Err("field width")}
};
