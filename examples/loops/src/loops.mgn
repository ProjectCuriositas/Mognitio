namespace App;
let main: Function(): Unit = function(): Unit {
var count: Int = 0;
var result: Int = 0;
loop while (count < 4) {
    count = count + 1;
    branch when {
        count < 4 => { continue; },
        else => unit,
    };
    result = count * 10;
};
branch when { (result == 40) == true => unit, else => panic {"fixture mismatch"} } };
