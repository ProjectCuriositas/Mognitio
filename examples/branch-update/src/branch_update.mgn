namespace App;
let main: Function(List<String>): Int = function(args: List<String>): Int {
var count: Int = 1;
let total: Int = branch when{(count < 2)=>{
    count = count + 1;
    count * 120
},else=>{
    0
}};
branch when { (branch when{(total == 240)=>{ count == 2 },else=>{ false }}) == true => 0, else => panic {"fixture mismatch"} } };
