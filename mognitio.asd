(asdf:defsystem "mognitio"
  :description "Mognitio compiler"
  :version "0.8.1"
  :depends-on ("sb-posix")
  :serial t
  :components ((:file "src/packages")
               (:file "src/diagnostics")
               (:file "src/runtime-failure")
               (:file "src/integer")
               (:file "src/source")
               (:file "src/syntax")
               (:file "src/syntax-values")
               (:file "src/syntax-generics")
               (:file "src/lexer")
               (:file "src/parser-values")
               (:file "src/parser")
               (:file "src/semantic-model")
               (:file "src/type-model")
               (:file "src/generic-types")
               (:file "src/semantic-values")
               (:file "src/semantic")
               (:file "src/checked-values")
               (:file "src/checked-generics")
               (:file "src/checked-program")
               (:file "src/specialization-model")
               (:file "src/specialization")
               (:file "src/specialization-verifier")
               (:file "src/text-runtime")
               (:file "src/panic-runtime")
               (:file "src/value-runtime")
               (:file "src/backend-common-lisp")
               (:file "src/backend-cl-values")
               (:file "src/target")
               (:file "src/ir")
               (:file "src/ir-values")
               (:file "src/ir-errors")
               (:file "src/ir-value-verifier")
               (:file "src/root-analysis")
               (:file "src/root-verifier")
               (:file "src/register-allocation")
               (:file "src/object-model")
               (:file "src/native-context")
               (:file "src/native-values")
               (:file "src/native-frame")
               (:file "src/native-memory")
               (:file "src/native-gc")
               (:file "src/native-text")
               (:file "src/native-panic")
               (:file "src/machine-ir")
               (:file "src/amd64")
               (:file "src/elf")
               (:file "src/backend-native")
               (:file "src/artifact")
               (:file "src/driver")
               (:file "src/cli"))
  :in-order-to ((asdf:test-op (asdf:test-op "mognitio/tests"))))

(asdf:defsystem "mognitio/tests"
  :depends-on ("mognitio")
  :serial t
  :components ((:file "tests/harness")
               (:file "tests/source-frontend")
               (:file "tests/semantic-backend")
               (:file "tests/driver-process")
               (:file "tests/generated")
               (:file "tests/native-ir")
               (:file "tests/native-process")
               (:file "tests/native-generated")
               (:file "tests/v03-kernel")
               (:file "tests/v03-merge")
               (:file "tests/v03-generated")
               (:file "tests/v04-allocation")
               (:file "tests/v04-functions")
               (:file "tests/v04-generated")
               (:file "tests/v04-boundaries")
               (:file "tests/v04-artifacts")
               (:file "tests/v05-core")
               (:file "tests/v05-functions")
               (:file "tests/v05-values")
               (:file "tests/v05-loops")
               (:file "tests/v05-generated")
               (:file "tests/v05-conformance")
               (:file "tests/v05-boundaries")
               (:file "tests/v06-compatibility")
               (:file "tests/v06-frontend")
               (:file "tests/v06-host")
               (:file "tests/v06-core")
               (:file "tests/v06-roots")
               (:file "tests/v06-native-frames")
               (:file "tests/v06-native-text")
               (:file "tests/v06-native-gc")
               (:file "tests/v06-native-faults")
               (:file "tests/v06-integration")
               (:file "tests/v07-values")
               (:file "tests/v07-methods")
               (:file "tests/v07-lifetime")
               (:file "tests/v07-boundaries")
               (:file "tests/v07-integration")
               (:file "tests/v07-review")
               (:file "tests/v08-frontend")
               (:file "tests/v08-bindings")
               (:file "tests/v08-types")
               (:file "tests/v08-functions")
               (:file "tests/v08-specialization")
               (:file "tests/v08-errors")
               (:file "tests/v08-runtime")
               (:file "tests/v08-conformance")
               (:file "tests/v08-core")
               (:file "tests/v08-lifetime")
               (:file "tests/v09-source"))
  :perform (asdf:test-op (op system)
             (declare (ignore op system))
             (uiop:symbol-call :mognitio.tests :run-tests)))
